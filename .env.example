APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Meta / Instagram (Business Login + Messaging)
# From App Dashboard → Instagram → API setup with Instagram login → Business login settings
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_REDIRECT_URI="${APP_URL}/settings/instagram/callback"
META_GRAPH_VERSION=v21.0

# Telegram User Account (MadelineProto - for Group Crawler & Inbox)
# Get from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# اختیاری — MadelineProto (timeout قفل و عملیات، ثانیه)
# MADELINE_PROTO_RUN_TIMEOUT=300
# MADELINE_PROTO_CACHE_LOCK_TTL=600
# MADELINE_PROTO_CACHE_LOCK_BLOCK=180
# اختیاری: برای وب‌هوک ربات، اگر با APP_URL متفاوت است
# TELEGRAM_WEBHOOK_URL=https://your-domain.com

# Google Contacts sync (CRM → Google, OAuth) — همان Redirect URI را در Google Cloud Console اضافه کنید
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI="${APP_URL}/settings/google-contacts/callback"
# همگام‌سازی انبوه: تأخیر بین هر مشتری (میلی‌ثانیه) — سقف نمونه API حدود ۹۰ خواندن بحرانی/دقیقه
# GOOGLE_CONTACTS_BULK_SYNC_DELAY_MS=700
# GOOGLE_CONTACTS_QUOTA_MAX_RETRIES=5
# GOOGLE_CONTACTS_QUOTA_RETRY_BASE_SECONDS=65
